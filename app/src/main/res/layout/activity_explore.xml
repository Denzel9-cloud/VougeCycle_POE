<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/vc_white">

    <!-- ====== SEARCH BAR ====== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="20dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="@drawable/bg_search_bar"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="14dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_search"
                android:contentDescription="Search"/>

            <EditText
                android:id="@+id/etSearch"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:background="@null"
                android:hint="Search products"
                android:textSize="14sp"
                android:inputType="text"
                android:importantForAutofill="no"/>
        </LinearLayout>
    </LinearLayout>

    <!-- ====== CATEGORY CHIPS ====== -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="20dp"
        android:paddingBottom="12dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/chipAll"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_chip"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp"
                android:text="All"
                android:textColor="@color/vc_black"
                android:textSize="13sp"/>

            <TextView
                android:id="@+id/chipMen"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:background="@drawable/bg_chip"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp"
                android:text="Men"
                android:textColor="@color/vc_black"
                android:textSize="13sp"/>

            <TextView
                android:id="@+id/chipWomen"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:background="@drawable/bg_chip"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp"
                android:text="Women"
                android:textColor="@color/vc_black"
                android:textSize="13sp"/>

            <TextView
                android:id="@+id/chipVintage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:background="@drawable/bg_chip"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp"
                android:text="Vintage"
                android:textColor="@color/vc_black"
                android:textSize="13sp"/>

            <TextView
                android:id="@+id/chipEras"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:background="@drawable/bg_chip"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp"
                android:text="Eras"
                android:textColor="@color/vc_black"
                android:textSize="13sp"/>

            <TextView
                android:id="@+id/chipSports"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:background="@drawable/bg_chip"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp"
                android:text="Sports"
                android:textColor="@color/vc_black"
                android:textSize="13sp"/>
        </LinearLayout>
    </HorizontalScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:layout_marginBottom="8dp"
        android:orientation="vertical"
        android:background="@drawable/bg_more_options_panel">

        <LinearLayout
            android:id="@+id/btnMoreOptions"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="14dp"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="More Options">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="More Options"
                android:textColor="@color/vc_black"
                android:textSize="15sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/tvMoreOptionsArrow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⌄"
                android:textColor="@color/vc_green"
                android:textSize="20sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/llAdvancedFilters"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="12dp"
            android:paddingBottom="10dp"
            android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <Spinner
                android:id="@+id/spCondition"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="@drawable/bg_input_field"
                android:paddingHorizontal="10dp" />
            <Spinner
                android:id="@+id/spSort"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:background="@drawable/bg_input_field"
                android:paddingHorizontal="10dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">
            <EditText
                android:id="@+id/etMinPrice"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="@drawable/bg_input_field"
                android:hint="Min price"
                android:inputType="numberDecimal"
                android:paddingHorizontal="12dp"
                android:textColor="@color/vc_black"
                android:textColorHint="@color/vc_grey_text" />
            <EditText
                android:id="@+id/etMaxPrice"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:background="@drawable/bg_input_field"
                android:hint="Max price"
                android:inputType="numberDecimal"
                android:paddingHorizontal="12dp"
                android:textColor="@color/vc_black"
                android:textColorHint="@color/vc_grey_text" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <CheckBox
                android:id="@+id/cbIncludeSold"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:buttonTint="@color/vc_green"
                android:text="Include sold items"
                android:textColor="@color/vc_black"
                android:textSize="13sp" />
            <Button
                android:id="@+id/btnClearFilters"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:background="@drawable/bg_button_outline"
                android:text="Clear filters"
                android:textAllCaps="false"
                android:textColor="@color/vc_green" />
        </LinearLayout>

        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/tvResultCount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginBottom="4dp"
        android:text="0 items"
        android:textColor="@color/vc_grey_text"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/tvNoResults"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:padding="32dp"
        android:text="No products found\nTry changing or clearing your filters"
        android:textColor="@color/vc_grey_text"
        android:textSize="15sp"
        android:visibility="gone" />

    <ProgressBar
        android:id="@+id/progressExplore"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="gone" />

    <Button
        android:id="@+id/btnRetryExplore"
        android:layout_width="wrap_content"
        android:layout_height="46dp"
        android:layout_gravity="center"
        android:background="@drawable/bg_button_outline"
        android:text="Retry loading"
        android:textAllCaps="false"
        android:textColor="@color/vc_green"
        android:visibility="gone" />

    <!-- ====== PRODUCT GRID (weight=1 so it fills the middle) ====== -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvExplore"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingHorizontal="14dp"
        android:clipToPadding="false"/>

    <!-- ====== BOTTOM NAV ====== -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/vc_border"/>

    <include
        android:id="@+id/bottomNav"
        layout="@layout/bottom_nav"/>

</LinearLayout>
