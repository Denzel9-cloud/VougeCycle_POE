<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" app:cardBackgroundColor="@color/vc_off_white" app:cardCornerRadius="12dp" app:cardElevation="0dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
            <TextView android:id="@+id/tvReviewerName" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@buyer" android:textColor="@color/vc_black" android:textSize="15sp" android:textStyle="bold" />
            <TextView android:id="@+id/tvReviewDate" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="2026-09-22" android:textColor="@color/vc_grey_text" android:textSize="11sp" />
        </LinearLayout>
        <TextView android:id="@+id/tvReviewStars" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="★★★★★" android:textColor="@color/vc_gold" android:textSize="19sp" />
        <TextView android:id="@+id/tvReviewComment" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:lineSpacingExtra="3dp" android:text="Review comment" android:textColor="@color/vc_black" android:textSize="14sp" />
    </LinearLayout>
</androidx.cardview.widget.CardView>
